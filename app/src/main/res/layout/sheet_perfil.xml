<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="104dp">

        <TextView
            android:id="@+id/txtAvatarSheet"
            style="@style/Avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textSize="36sp" />

        <View
            android:id="@+id/pontoOnlineSheet"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_ponto_online"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/txtNomeSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtStatusSheet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="13.5sp" />

    <TextView
        android:id="@+id/txtRecadoSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_recado"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAcaoSheet"
        style="@style/BotaoPrincipal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="@string/abrir_chat"
        app:icon="@drawable/ic_chat"
        app:iconGravity="textStart" />
</LinearLayout>
