<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        DayNight: o app acompanha o tema do aparelho. As cores mudam sozinhas porque
        values-night/colors.xml sobrescreve os mesmos nomes. As barras do sistema sao
        configuradas em codigo (util/Janela.java), por isso nao aparecem aqui.
    -->
    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/on_brand_container</item>
        <item name="colorSecondaryContainer">@color/brand_container</item>
        <item name="colorOnSecondaryContainer">@color/on_brand_container</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="colorError">@color/error_color</item>
        <item name="android:colorBackground">@color/screen_bg</item>
        <item name="android:windowBackground">@color/screen_bg</item>
    </style>

    <style name="AppTheme.Splash">
        <item name="android:windowBackground">@drawable/bg_gradient_brand</item>
    </style>

    <!-- Campos de texto arredondados usados no login, cadastro e perfil -->
    <style name="CampoTexto" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/brand</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <style name="BotaoPrincipal" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Avatar">
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="CaixaMensagem">
        <item name="android:background">@drawable/bg_input_pill</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:maxLines">5</item>
        <item name="android:maxLength">2000</item>
        <item name="android:inputType">textCapSentences|textMultiLine</item>
        <item name="android:textSize">15.5sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
    </style>

    <style name="BotaoEnviar">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:background">@drawable/bg_btn_enviar</item>
        <item name="android:padding">13dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:src">@drawable/ic_send</item>
        <item name="android:contentDescription">@string/enviar</item>
    </style>
</resources>
